[Unit]
Description=Orion Job Scheduler
After=network.target tailscaled.service

[Service]
Type=simple
User=orion
WorkingDirectory=/home/orion/server
ExecStart=/home/orion/server/venv/bin/python3 /home/orion/server/scripts/orion-scheduler.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
